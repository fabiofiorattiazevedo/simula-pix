# Aplicação
NODE_ENV=development
PORT=3000

# Banco de dados
# Rodando localmente (fora do Docker):
MONGODB_URI=mongodb://localhost:27017/pix_api
# Rodando com Docker Compose (o docker-compose.yml sobrescreve para "mongo"):
# MONGODB_URI=mongodb://mongo:27017/pix_api

# JWT
JWT_SECRET=sua_chave_secreta_jwt
JWT_EXPIRES_IN=1d

# Mercado Pago — https://www.mercadopago.com.br/developers
# Access Token gerado em: Painel MP > Suas integrações > Credenciais
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_BASE_URL=https://api.mercadopago.com

# Webhook — URL pública que o MP irá chamar ao atualizar um pagamento
# Cadastre em: Painel MP > Suas integrações > Webhooks
WEBHOOK_URL=https://sua-api.com/api/webhook/notificacao

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
